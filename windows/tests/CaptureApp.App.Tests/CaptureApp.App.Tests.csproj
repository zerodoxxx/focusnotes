<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Windows-only tests: run them only on Windows hosts. -->
    <IsTestProject>$([MSBuild]::IsOSPlatform('Windows'))</IsTestProject>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
    <!-- The lock file would record the app's assembly name, which the name check forbids outside Config/app.env. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="../../src/CaptureApp.App/CaptureApp.App.csproj" />
  </ItemGroup>
</Project>
